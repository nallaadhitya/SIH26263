PORT=5000
STORAGE_DRIVER=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=eduverify_local
MYSQL_USER=eduverify_app
# Set MYSQL_PASSWORD only locally; there is no default password.
# Optional separate MYSQL_MIGRATION_USER / MYSQL_MIGRATION_PASSWORD for DDL.
# For controlled local JSON fallback select STORAGE_DRIVER=json explicitly.
DATA_DIR=data/local
APP_ORIGIN=http://localhost:5000
COOKIE_SECURE=false
ML_SERVICE_URL=http://127.0.0.1:8000
ML_TIMEOUT_MS=3000
# Set ML_SERVICE_KEY locally (32+ characters), identical to the Python environment.
# SESSION_SECRET is optional locally: a random signing key is generated on startup.
# Set DEMO_ACCOUNT_PASSWORD only in your ignored .env or shell; no default password.
# QR_SIGNING_KEYS is a JSON map of key IDs to dedicated random 32-byte base64 keys.
# QR_ACTIVE_KEY_ID selects issuance key; no key or insecure fallback is provided.
# Generate/configure locally using docs/verification.md. Never reuse other secrets.
